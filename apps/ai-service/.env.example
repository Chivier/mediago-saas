# LM Studio OpenAI-compatible API
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LM_MODEL=Qwen3.6-35B-A3B
# Unload the model after this many seconds of inactivity (0 = never unload)
LM_IDLE_TIMEOUT=3600

# GPU concurrency limit
GPU_SLOTS=2

# FUNASR settings
FUNASR_DEVICE=cuda
FUNASR_MODEL=paraformer-zh

# Server settings
HOST=0.0.0.0
PORT=8899

# Storage path (same as apps/restful STORAGE_PATH)
STORAGE_PATH=/data/mediago/storage
