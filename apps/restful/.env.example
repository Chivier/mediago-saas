# apps/restful environment variables

# Port to listen on
PORT=8898

# Go backend (apps/core) base URL
MEDIAGO_BASE_URL=http://localhost:8080

# Storage directory (must match apps/core LOCAL_DIR for file access)
STORAGE_PATH=/home/user/Downloads/mediago

# API key to protect all endpoints (leave empty to disable auth)
PRIVATE_KEY=

# Storage limits
STORAGE_MAX_BYTES=107374182400  # 100 GB

# Auto-cleanup completed tasks older than N days
AUTO_CLEANUP=false
AUTO_CLEANUP_DAYS=7

# Concurrency limits
MAX_CONCURRENT_DOWNLOADS=3
MAX_CONCURRENT_TASKS=5
